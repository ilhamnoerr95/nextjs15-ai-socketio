// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:app.db"
}

// this is table name
model Product {
  id            Int    @id @default(autoincrement())
  title         String
  description   String?
  price         Int
}